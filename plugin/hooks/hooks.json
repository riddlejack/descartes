{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$STEMMA_PYTHON\" -I -m stemma.hooks pre",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$STEMMA_PYTHON\" -I -m stemma.hooks post",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$STEMMA_PYTHON\" -I -m stemma.hooks subagent-start",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
